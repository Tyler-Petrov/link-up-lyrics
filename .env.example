# Copy to .env.local (gitignored). `pnpm dev` writes the three Convex values itself the first time.

# Deployment used by `convex dev`
CONVEX_DEPLOYMENT=dev:your-dev-deployment
PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# Clerk development instance (Dashboard → API keys). Needs a JWT template named "convex".
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
