{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "link-up-lyrics",
	"account_id": "f8bdca2bb163fea5cdabf6348bef9049",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"env": {
		// PR previews (.github/workflows/deploy-preview.yml): their own Worker, since they run on the Clerk
		// development instance and its secret key, and each PR gets a pr-<number> preview URL on workers.dev.
		"preview": {
			"name": "link-up-lyrics-preview",
			"workers_dev": true,
			"preview_urls": true
		}
	}
}
