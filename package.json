{
	"name": "link-up-lyrics",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"release": "node scripts/release.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/convex/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@convex-dev/migrations": "^0.3.7",
		"@convex-dev/presence": "^0.4.0",
		"@convex-dev/rate-limiter": "^0.4.3",
		"convex": "^1.49.0",
		"convex-helpers": "^0.1.134",
		"convex-svelte": "^0.15.1",
		"mode-watcher": "^1.1.0",
		"runed": "^0.38.0",
		"sortablejs": "^1.15.7",
		"svelte-clerk": "^1.3.0",
		"uqr": "^0.1.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.9.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/sortablejs": "^1.15.9",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"wrangler": "^4.158.0"
